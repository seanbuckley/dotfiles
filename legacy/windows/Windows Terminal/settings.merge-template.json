{
  "copyOnSelect": true,
  "actions": [
    {
      "command": {
        "action": "sendInput",
        "input": "cd ..\r"
      },
      "keys": "ctrl+up",
      "name": "Navigate to parent directory"
    },
    {
      "command": "paste",
      "keys": "ctrl+v"
    },
    {
      "command": "find",
      "keys": "ctrl+shift+f"
    },
    {
      "command": {
        "action": "splitPane",
        "split": "auto",
        "splitMode": "duplicate"
      },
      "keys": "alt+shift+d",
      "name": "Split the pane"
    },
    {
      "command": {
        "action": "sendInput",
        "input": "clear\r"
      },
      "keys": "alt+k",
      "name": "Clear terminal"
    }
